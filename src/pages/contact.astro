---
import Layout from '../layouts/Layout.astro';
// TODO (operator): create a Tally form for inquiries (fields: name, organization, role, email,
// the process that eats the most time, systems involved, how you heard of us) and paste its
// embed URL below in place of TALLY_FORM_ID. Until then the page works on email alone.
const TALLY_FORM_ID = '';
const mailto =
  'mailto:devin.macarthur@cascadiasystems.org?subject=' +
  encodeURIComponent('30-minute call — [your organization]') +
  '&body=' +
  encodeURIComponent(
    'Organization:\nYour role:\nThe process that eats the most time:\nSystems involved:\nBest times for a 30-minute call:\n'
  );
---

<Layout
  title="Contact"
  description="Book a 30-minute call with Cascadia Systems — Portland, Oregon"
>
  <section class="hero-topo section bg-gradient-to-b from-dark-bg via-dark-surface to-dark-bg">
    <div class="container-custom">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl">Contact</h1>
        <p class="text-lg text-text-secondary">
          Email is best. Every message is read by Devin and answered within two business days,
          usually sooner. A paragraph about the process in question is plenty; the rest gets asked
          on the call.
        </p>
      </div>
    </div>
  </section>

  <section class="section border-t border-dark-border">
    <div class="container-custom">
      <div class="mx-auto max-w-4xl">
        <div class="grid gap-6 md:grid-cols-2">
          <div class="card">
            <h2 class="mb-3 text-xl font-semibold text-accent-blue">Email</h2>
            <p class="mb-4 text-text-secondary">
              <a href="mailto:devin.macarthur@cascadiasystems.org" class="link">devin.macarthur@cascadiasystems.org</a>
            </p>
            <p class="mb-6 text-sm text-text-secondary">
              The button opens a message with the questions that come first anyway. Skip any you
              don't know.
            </p>
            <a href={mailto} class="btn btn-primary">Email to book a call</a>
          </div>

          <div class="card">
            <h2 class="mb-3 text-xl font-semibold text-accent-cyan">What to include</h2>
            <ul class="list-disc space-y-2 pl-6 text-sm text-text-secondary">
              <li>Your organization and your role.</li>
              <li>The process that costs the most staff time, in a sentence.</li>
              <li>The systems involved, as best you know them.</li>
              <li>Two or three times that work for a call.</li>
            </ul>
          </div>
        </div>

        {TALLY_FORM_ID && (
          <div class="mt-10">
            <iframe
              src={`https://tally.so/embed/${TALLY_FORM_ID}?alignLeft=1&hideTitle=1&transparentBackground=1`}
              loading="lazy"
              width="100%"
              height="600"
              style="border:0;margin:0"
              title="Inquiry form"
            ></iframe>
          </div>
        )}

        <div class="mt-12 grid gap-6 md:grid-cols-3">
          <div class="card">
            <h3 class="mb-2 text-sm font-semibold uppercase tracking-wider text-text-primary">Base</h3>
            <p class="text-sm text-text-secondary">East Portland. Remote work anywhere in the US; on site around Portland.</p>
          </div>
          <div class="card">
            <h3 class="mb-2 text-sm font-semibold uppercase tracking-wider text-text-primary">Engagements</h3>
            <p class="text-sm text-text-secondary">The thirty-day engagement, single builds, and embedded engineering. All available now.</p>
          </div>
          <div class="card">
            <h3 class="mb-2 text-sm font-semibold uppercase tracking-wider text-text-primary">Entity</h3>
            <p class="text-sm text-text-secondary">Cascadia Mobile Research LLC, an Oregon limited liability company. Certificate of insurance on request.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
