---
const currentYear = new Date().getFullYear();
// TODO (operator): once the Oregon assumed business name is filed, change the legal line to
// "Cascadia Mobile Research LLC, doing business as Cascadia Systems".
---

<footer class="border-t border-dark-border bg-dark-surface">
  <div class="container-custom py-12">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <!-- About -->
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-text-primary">
          Cascadia Systems
        </h3>
        <p class="text-sm text-text-secondary">
          Devin MacArthur's data-systems practice. I automate the work your staff does by hand.
        </p>
        <p class="mt-3 text-sm text-text-muted">East Portland, Oregon</p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-text-primary">
          Site
        </h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/services/" class="link">Services</a></li>
          <li><a href="/about/" class="link">About</a></li>
          <li><a href="/contact/" class="link">Contact</a></li>
          <li>
            <a href="https://github.com/cascadia-systems-lab" class="link" rel="noopener noreferrer">GitHub</a>
          </li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-text-primary">
          Contact
        </h3>
        <div class="space-y-2 text-sm text-text-secondary">
          <p>
            <a href="mailto:devin.macarthur@cascadiasystems.org" class="link">devin.macarthur@cascadiasystems.org</a>
          </p>
          <p>I reply within two business days.</p>
          <p><a href="/contact/" class="link">Contact page</a></p>
        </div>
      </div>
    </div>

    <div class="mt-8 border-t border-dark-border pt-8 text-center text-sm text-text-muted">
      <p>
        &copy; {currentYear} Cascadia Mobile Research LLC &middot; Portland, Oregon
      </p>
    </div>
  </div>
</footer>
