---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-dark-border bg-dark-surface">
  <div class="container-custom py-12">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <!-- About -->
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-text-primary">
          Cascadia Mobile Research
        </h3>
        <p class="text-sm text-text-secondary">
          Drone-based field data collection and self-hosted spatial data processing.
          Independent, instrument-driven, and documented in the open.
        </p>
        <p class="mt-3 text-sm text-text-muted">Portland, Oregon</p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-text-primary">
          Resources
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/services/" class="link">
              Services
            </a>
          </li>
          <li>
            <a href="/research/" class="link">
              Lab Notes
            </a>
          </li>
          <li>
            <a href="/documentation/" class="link">
              Documentation
            </a>
          </li>
          <li>
            <a href="https://github.com/cascadia-systems-lab" class="link">
              GitHub
            </a>
          </li>
        </ul>
      </div>

      <!-- Contact & Status -->
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-text-primary">
          Contact
        </h3>
        <div class="space-y-2 text-sm text-text-secondary">
          <p>
            Inquiries:
            <a
              href="https://github.com/cascadia-systems-lab/cascadia-lab.github.io/issues/new?template=inquiry.yml"
              class="link"
            >open a project inquiry</a>
            (free GitHub account required).
          </p>
          <p>Last Updated: {new Date().toLocaleDateString('en-CA', { timeZone: 'America/Los_Angeles' })}</p>
        </div>
      </div>
    </div>

    <div class="mt-8 border-t border-dark-border pt-8 text-center text-sm text-text-muted">
      <p>
        &copy; {currentYear} Cascadia Mobile Research LLC &middot; Portland, Oregon
      </p>
    </div>
  </div>
</footer>
